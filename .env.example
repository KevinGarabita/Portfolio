# Copy this file to .env.local for local development. Never commit real values.

# Public base URL of the site, with scheme and without a trailing slash
# (for example https://example.com). It feeds metadataBase, canonical URLs,
# hreflang links, the sitemap and structured data.
# In Vercel, set it for the Production environment once the domain is connected.
# When empty, the site uses Vercel's production URL, or http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=
