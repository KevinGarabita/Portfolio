# Copy this file to .env.local for local development. Never commit real values.

# Public base URL of the site, with scheme and without a trailing slash
# (for example https://example.com). It feeds metadataBase (and with it the
# Open Graph image URLs), canonical URLs, hreflang links, the sitemap, robots.txt
# and structured data.
# In Vercel, set it for the Production environment to the primary host once the
# domain is connected (the one the other host redirects to), then redeploy: it is
# read at build time.
# When empty, the site uses Vercel's production URL, or http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=

# Provided automatically by Vercel. Do not set them by hand.
# VERCEL_PROJECT_PRODUCTION_URL: production domain without scheme; fallback when
#   NEXT_PUBLIC_SITE_URL is empty. With several custom domains Vercel picks the
#   shortest one, which may not be the primary host.
# VERCEL_ENV: "production", "preview" or "development". A production build fails
#   while any [PLACEHOLDER] content remains.
